@model IEnumerable<BaerbeariaMVC.Models.Servico>
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="pt-br">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Barber Unip</title>

    
    <link rel="icon" href="~/img/icon/favicon.ico" type="image/x-icon">

    
    <link rel="apple-touch-icon" href="~/img/icon/apple-touch-icon.png">

    
    <link rel="icon" type="image/png" sizes="32x32" href="~/img/icon/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="~/img/icon/favicon-16x16.png">
    <link rel="manifest" href="~/img/icon/site.webmanifest">

    
    <link rel="stylesheet" href="~/css/style.css">
</head>

<body>
    <header>
        <nav>
            <a asp-controller="Home" asp-action="Index" class="Logo">
                <img src="~/img/logo/barbearia.png" alt="Logo" class="LogoImg">
                <span>Barber Unip</span>
            </a>
            <ul class="Links">
                <li><a href="#sobre">Sobre</a></li>
                <li><a href="#servicos">Serviços</a></li>
                <li><a href="#portfolio">Portfólio</a></li>
                <li><a href="#localizacao">Localização</a></li>
                <li><a asp-controller="Agendar" asp-action="Index">Agendar</a></li>
            </ul>
        </nav>
    </header>

    <div class="container-sobre">
        <section id="sobre" class="secao-flex">
            <div class="imagem-sobre">
                <img src="~/img/barbearia/barbearia-interno.jpg" alt="Interior da Barbearia">
            </div>
            <div class="texto-sobre">
                <h1>Sobre a BARBER UNIP</h1>
                <p>
                    Na BARBER UNIP, acreditamos que o visual de um homem é o seu cartão de visitas. Fundada em 2026,
                    nossa barbearia une a precisão da alfaiataria clássica com as tendências modernas de visagismo.
                    Aqui, cada detalhe é planejado para oferecer mais que um serviço: entregamos uma experiência de
                    cuidado, conforto e bem-estar, garantindo que você saia pronto para enfrentar qualquer desafio com
                    confiança renovada.
                </p>
            </div>
        </section>
    </div>

    
    <section id="servicos" class="secao">
        <div class="titulo">
            <h1>Serviços</h1>
            <p>Oferecemos uma variedade de serviços para atender às suas necessidades de cuidado pessoal:</p>
        </div>

        <div class="lista-servicos" id="vitrine-servicos">
            @if (Model != null && Model.Any())
            {
                foreach (var servico in Model)
                {
                    <div class="card-servico">
                        <h3>@servico.Nome</h3>
                        <p class="preco">R$ @servico.Preco.ToString("N2")</p>
                        <a asp-controller="Agendar" asp-action="Index" class="btn-escolher">Agendar</a>
                    </div>
                }
            }
            else
            {
                <p>Nenhum serviço disponível no momento.</p>
            }
        </div>
    </section>

    <div class="container">
        <section id="portfolio" class="secao">
            <div class="titulo">
                <h1>Portfólio</h1>
                <p>Confira alguns dos nossos trabalhos:</p>
            </div>

            <div class="portfolio">
                <div class="fotos">
                    <img src="~/img/cortes/portfolio1.png" alt="Moicano com fade">
                    <p>Barbeiro: Allan Kleyver</p>
                </div>
                <div class="fotos">
                    <img src="~/img/cortes/portfolio2.jpg" alt="Fade alto">
                    <p>Barbeiro: Naldin</p>
                </div>
                <div class="fotos">
                    <img src="~/img/cortes/portfolio3.png" alt="V atrás com fade">
                    <p>Barbeiro: Bernades</p>
                </div>
                <div class="fotos">
                    <img src="~/img/cortes/portfolio4.png" alt="Corte social na tesoura">
                    <p>Barbeiro: Naldin</p>
                </div>
                <div class="fotos">
                    <img src="~/img/cortes/portfolio5.png" alt="Taper fade com barba desenhada">
                    <p>Barbeiro: Bernades</p>
                </div>
                <div class="fotos">
                    <img src="~/img/cortes/portfolio6.png" alt="Degradê tradicional">
                    <p>Barbeiro: Allan Kleyver</p>
                </div>
            </div>
        </section>

        <section id="localizacao" class="secao">
            <div class="titulo">
                <h1>Localização</h1>
                <p>
                    Venha nos visitar e experimente nossos serviços de alta qualidade em um ambiente <br> acolhedor
                    e profissional. Estamos ansiosos para cuidar do seu visual e proporcionar uma experiência única de
                    barbearia!
                </p>
                <p>Confira onde estamos:</p>
            </div>
            <div class="mapa">
                <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d238.80338895675038!2d-49.240305954019234!3d-16.734123939343437!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x935ef063b7679c6f%3A0xc5a39194d233e274!2sBernardes%20barbearia!5e0!3m2!1spt-BR!2sbr!4v1777995724150!5m2!1spt-BR!2sbr"
                        loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
                <div>
                    <h1>Av. Bela Vista, Qd 2b lote 05 - Jardim Bela Vista, Goiânia - GO, 74863-050</h1>
                    <h1>
                        <a href="https://maps.app.goo.gl/J6cbJ9x8UMThfi7o8" target="_blank">Ver no Google Maps</a>
                    </h1>
                </div>
            </div>
        </section>

        <section id="agendar" class="secao">
            <div class="titulo">
                <h1>Agendamento Online</h1>
                <p>Escolha o profissional de sua preferência, confira a agenda em tempo real e reserve seu horário:</p>
            </div>
    
            <div class="cta-agendar-box">
                <div class="cta-card">
                    <div class="cta-icone">✂️</div>
                    <h2>Pronto para renovar o visual?</h2>
                    <p>Atendimento exclusivo com hora marcada, sem espera e com os barbeiros da Barber UNIP.</p>
                    <a asp-controller="Agendar" asp-action="Index" class="btn-ir-agendar">
                        Escolher Profissional e Horário
                    </a>
                </div>
            </div>
        </section>
    </div>

    <footer>
        <p>&copy; 2026 Barber Unip. Todos os direitos reservados. <a asp-controller="Conta" asp-action="Login">admin</a></p>
    </footer>

    
    <script src="~/js/script.js"></script>

    
    <div vw class="enabled">
        <div vw-access-button class="active"></div>
        <div vw-plugin-wrapper>
            <div class="vw-plugin-top-wrapper"></div>
        </div>
    </div>
    <script src="https://vlibras.gov.br/app/vlibras-plugin.js"></script>
    <script>
        new window.VLibras.Widget('https://vlibras.gov.br/app');
    </script>
</body>

</html>