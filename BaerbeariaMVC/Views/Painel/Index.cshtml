@model List<BaerbeariaMVC.Models.Agendamento>
@{
    Layout = null;
    var dataSelecionada = ViewBag.Data as string ?? DateTime.Today.ToString("yyyy-MM-dd");
}

<!DOCTYPE html>
<html lang="pt-br">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Painel Administrativo - Barber UNIP</title>

        
    <link rel="icon" href="~/img/icon/favicon.ico" type="image/x-icon">

    
    <link rel="apple-touch-icon" href="~/img/icon/apple-touch-icon.png">

    
    <link rel="icon" type="image/png" sizes="32x32" href="~/img/icon/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="~/img/icon/favicon-16x16.png">
    <link rel="manifest" href="~/img/icon/site.webmanifest">
    <link rel="stylesheet" href="~/css/style.css">

    <style>
        body {
            background-color: #0e0e0e;
            color: #ffffff;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        /* Topo Administrativo */
        header {
            background-color: #141414;
            border-bottom: 1px solid rgba(212, 175, 55, 0.25);
            padding: 0 30px;
            position: sticky;
            top: 0;
            z-index: 1000;
        }

        header nav {
            display: flex;
            justify-content: space-between;
            align-items: center;
            height: 70px;
            max-width: 1300px;
            margin: 0 auto;
        }

        .Logo {
            display: flex;
            align-items: center;
            gap: 12px;
            text-decoration: none;
            color: #ffffff;
            font-size: 1.3rem;
            font-weight: bold;
            letter-spacing: 1px;
        }

        .LogoImg {
            height: 42px;
            width: auto;
        }

        .Links {
            display: flex;
            align-items: center;
            gap: 20px;
            list-style: none;
        }

        .Links a, .btn-logout {
            color: #dddddd;
            text-decoration: none;
            font-size: 0.95rem;
            font-weight: 600;
            transition: color 0.2s ease;
            background: none;
            border: none;
            cursor: pointer;
            padding: 0;
        }

        .Links a:hover, .btn-logout:hover {
            color: #d4af37;
        }

        .Links a.ativo {
            color: #d4af37;
            border-bottom: 2px solid #d4af37;
            padding-bottom: 4px;
        }

        /* Container Principal */
        .container-admin {
            flex: 1;
            max-width: 1250px;
            width: 100%;
            margin: 30px auto;
            padding: 0 20px;
            box-sizing: border-box;
        }

        .secao-admin-bloco {
            background-color: #181818;
            border: 1px solid rgba(212, 175, 55, 0.25);
            border-radius: 14px;
            padding: 30px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
        }

        .topo-secao {
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 20px;
            margin-bottom: 25px;
            border-bottom: 1px solid #2a2a2a;
            padding-bottom: 20px;
        }

        .topo-secao h1 {
            color: #d4af37;
            font-size: 1.8rem;
            margin: 0;
        }

        /* Filtros de Data */
        .filtro-agenda {
            display: flex;
            align-items: center;
            gap: 12px;
            flex-wrap: wrap;
        }

        .filtro-agenda label {
            color: #bbbbbb;
            font-size: 0.95rem;
            font-weight: 500;
        }

        .filtro-agenda input[type="date"] {
            background-color: #242424;
            border: 1px solid #444444;
            color: #ffffff;
            padding: 9px 14px;
            border-radius: 6px;
            font-size: 0.95rem;
            outline: none;
            transition: border-color 0.2s;
        }

        .filtro-agenda input[type="date"]:focus {
            border-color: #d4af37;
        }

        .btn-filtrar {
            background-color: #d4af37;
            color: #121212;
            border: none;
            padding: 9px 18px;
            border-radius: 6px;
            font-weight: 700;
            cursor: pointer;
            transition: all 0.2s;
        }

        .btn-filtrar:hover {
            background-color: #f1c40f;
            transform: translateY(-1px);
        }

        .btn-hoje {
            background-color: transparent;
            color: #d4af37;
            border: 1px solid #d4af37;
            padding: 8px 16px;
            border-radius: 6px;
            font-weight: 600;
            text-decoration: none;
            font-size: 0.9rem;
            transition: all 0.2s;
        }

        .btn-hoje:hover {
            background-color: rgba(212, 175, 55, 0.15);
        }

        /* Tabela Responsiva */
        .tabela-responsiva {
            overflow-x: auto;
            width: 100%;
        }

        .tabela-admin {
            width: 100%;
            border-collapse: collapse;
            text-align: left;
            margin-top: 10px;
        }

        .tabela-admin th {
            background-color: #121212;
            color: #d4af37;
            padding: 14px 16px;
            font-size: 0.9rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            border-bottom: 2px solid #2a2a2a;
        }

        .tabela-admin td {
            padding: 14px 16px;
            border-bottom: 1px solid #242424;
            font-size: 0.95rem;
            color: #dddddd;
            vertical-align: middle;
        }

        .tabela-admin tbody tr:hover {
            background-color: #1e1e1e;
        }

        /* Badges de Situação */
        .badge {
            display: inline-block;
            padding: 4px 10px;
            border-radius: 12px;
            font-size: 0.8rem;
            font-weight: 700;
            letter-spacing: 0.5px;
        }

        .badge-confirmado {
            background-color: rgba(46, 204, 113, 0.15);
            color: #2ecc71;
            border: 1px solid rgba(46, 204, 113, 0.3);
        }

        .badge-cancelado {
            background-color: rgba(231, 76, 60, 0.15);
            color: #e74c3c;
            border: 1px solid rgba(231, 76, 60, 0.3);
        }

        .btn-cancelar {
            background-color: rgba(231, 76, 60, 0.15);
            color: #ff6b6b;
            border: 1px solid #e74c3c;
            padding: 6px 14px;
            border-radius: 6px;
            font-size: 0.85rem;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.2s;
        }

        .btn-cancelar:hover {
            background-color: #e74c3c;
            color: #ffffff;
        }

        .link-zap {
            color: #25d366;
            text-decoration: none;
            font-weight: 600;
        }

        .link-zap:hover {
            text-decoration: underline;
        }

        .sem-dados {
            text-align: center;
            padding: 40px;
            color: #777777;
            font-size: 1.05rem;
        }

        /* Rodapé */
        footer {
            background-color: #0c0c0c;
            border-top: 1px solid #222222;
            padding: 20px;
            text-align: center;
            margin-top: auto;
        }

        footer p {
            color: #777777;
            font-size: 0.9rem;
            margin: 0;
        }
    </style>
</head>

<body>
    <header>
        <nav>
            <a asp-controller="Painel" asp-action="Index" class="Logo">
                <img src="~/img/logo/barbearia.png" alt="Logo" class="LogoImg">
                <span>Barber UNIP - Admin</span>
            </a>
            <ul class="Links">
                <li><a asp-controller="Painel" asp-action="Index" class="ativo">Agendamentos</a></li>
                <li><a asp-controller="Painel" asp-action="Barbeiros">Barbeiros</a></li>
                <li><a asp-controller="Painel" asp-action="Servicos">Serviços</a></li>
                <li>
                    <form asp-controller="Conta" asp-action="Sair" method="post" style="display:inline;">
                        <button type="submit" class="btn-logout">Sair</button>
                    </form>
                </li>
            </ul>
        </nav>
    </header>

    <div class="container-admin">
        <section class="secao-admin-bloco">
            <div class="topo-secao">
                <h1>Agendamentos do Dia</h1>

                
                <form asp-action="Index" method="get" class="filtro-agenda">
                    <label for="filtro-data">Data:</label>
                    <input type="date" id="filtro-data" name="data" value="@dataSelecionada" required />
                    <button type="submit" class="btn-filtrar">Filtrar</button>
                    <a asp-action="Index" class="btn-hoje">Hoje</a>
                </form>
            </div>

            <div class="tabela-responsiva">
                <table class="tabela-admin">
                    <thead>
                        <tr>
                            <th>Horário</th>
                            <th>Cliente</th>
                            <th>WhatsApp</th>
                            <th>Barbeiro</th>
                            <th>Serviço</th>
                            <th>Situação</th>
                            <th style="text-align: right;">Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td><strong>@item.DataHora.ToString("HH:mm")</strong></td>
                                    <td>@item.NomeCliente</td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(item.Telefone))
                                        {
                                            var numLimpo = new string(item.Telefone.Where(char.IsDigit).ToArray());
                                            var telFmt = numLimpo.Length == 11
                                                ? $"({numLimpo.Substring(0, 2)}) {numLimpo.Substring(2, 5)}-{numLimpo.Substring(7)}"
                                                : item.Telefone;

                                            <a href="https://wa.me/55@numLimpo" target="_blank" class="link-zap" title="Chamar no WhatsApp">
                                                @telFmt 💬
                                            </a>
                                        }
                                    </td>
                                    <td>@(item.Barbeiro?.Nome ?? "N/D")</td>
                                    <td>
                                        @(item.Servico?.Nome ?? "N/D")
                                        @if (item.Servico != null)
                                        {
                                            <span style="color: #d4af37; font-size: 0.85rem;">(R$ @item.Servico.Preco.ToString("N2"))</span>
                                        }
                                    </td>
                                    <td>
                                        @if (item.Cancelado)
                                        {
                                            <span class="badge badge-cancelado">Cancelado</span>
                                        }
                                        else
                                        {
                                            <span class="badge badge-confirmado">Confirmado</span>
                                        }
                                    </td>
                                    <td style="text-align: right;">
                                        @if (!item.Cancelado)
                                        {
                                            <form asp-action="Cancelar" method="post" onsubmit="return confirm('Deseja realmente cancelar este agendamento?');" style="display:inline;">
                                                <input type="hidden" name="id" value="@item.Id" />
                                                <input type="hidden" name="data" value="@dataSelecionada" />
                                                <button type="submit" class="btn-cancelar">Cancelar</button>
                                            </form>
                                        }
                                        else
                                        {
                                            <span style="color: #666; font-size: 0.85rem;">Sem ações</span>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="sem-dados">
                                    Nenhum agendamento encontrado para o dia @DateTime.Parse(dataSelecionada).ToString("dd/MM/yyyy").
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    </div>

    <footer>
        <p>&copy; 2026 Barber Unip. Painel Administrativo de Gestão.</p>
    </footer>
</body>

</html>